# Application
APP_NAME=Confidential ML Feature Store
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# DynamoDB
DYNAMODB_TABLE=confidential-ml-features
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST

# AWS KMS
KMS_KEY_ID=
KMS_KEY_ALIAS=alias/confidential-ml-feature-store
KMS_ALLOWED_ROLE_ARN=

# Enclave runtime
ENCLAVE_NAME=confidential-ml-inference
ENCLAVE_CID=16
ENCLAVE_PORT=5005
ENCLAVE_TIMEOUT_SECONDS=5.0
ENCLAVE_CPU_COUNT=2
ENCLAVE_MEMORY_MIB=2048
ENCLAVE_EIF_PATH=build/confidential-ml-feature-store.eif
ENCLAVE_DEBUG_MODE=false

# Enclave attestation measurements
ENCLAVE_PCR0=
ENCLAVE_PCR1=
ENCLAVE_PCR2=
ENCLAVE_PCR8=
ATTESTATION_REQUIRED=false

# Model artifact
MODEL_ARTIFACT_PATH=artifacts/model.joblib

# API tenancy and tracing
TENANT_HEADER_NAME=X-Tenant-ID
REQUEST_ID_HEADER_NAME=X-Request-ID

# Enclave image build
IMAGE_NAME=confidential-ml-enclave
IMAGE_TAG=latest
DOCKERFILE_PATH=enclave/Dockerfile.enclave
PRIVATE_KEY=
SIGNING_CERTIFICATE=
